    {
      "id": 14,
      "title": "Qualité observée (labels réels, hors tests de charge)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "Uniquement les prédictions avec observed_cnt ; population auto-sélectionnée.",
      "gridPos": {
        "x": 8,
        "y": 58,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.registered_name || ' v' || m.version AS \"Modèle\", count(*) AS \"Labels observés\", round(avg(abs(p.predicted_cnt - f.observed_cnt))::numeric, 2) AS \"MAE observée\", round(sqrt(avg((p.predicted_cnt - f.observed_cnt) ^ 2))::numeric, 2) AS \"RMSE observée\" FROM tracing.predictions p JOIN tracing.api_requests r USING (request_id) JOIN tracing.feedbacks f USING (prediction_id) JOIN tracing.model_versions m USING (model_id) WHERE $__timeFilter(p.created_at) AND r.campaign_id IN ($campaign) AND f.observed_cnt IS NOT NULL AND f.label_source NOT IN ('loadtest', 'synthetic') GROUP BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
