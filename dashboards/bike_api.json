          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(f.feedback_id) AS \"Feedbacks\", round(100.0 * avg(CASE WHEN f.useful THEN 1 WHEN f.useful = false THEN 0 END), 1) AS \"% utiles\", round(100.0 * count(f.feedback_id) / NULLIF(count(*), 0), 2) AS \"Couverture %\" FROM tracing.predictions p JOIN tracing.api_requests r USING (request_id) LEFT JOIN tracing.feedbacks f USING (prediction_id) WHERE $__timeFilter(p.created_at) AND r.campaign_id IN ($campaign)"
        }
