    },
    {
      "id": 6,
      "title": "Durée de traitement p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "processing_duration_ms : validation + inférence, hors commit et réseau. Percentiles calculés sur les requêtes, jamais moyennés entre workers.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS p95, percentile_cont(0.99) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS p99 FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status = 200 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Inférence p95 par endpoint",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY r.inference_duration_ms) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.inference_duration_ms IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Durées par endpoint",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.endpoint AS \"Endpoint\", count(*) AS \"Requêtes\", percentile_cont(0.5) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS \"p50 traitement\", percentile_cont(0.95) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS \"p95 traitement\", percentile_cont(0.99) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS \"p99 traitement\", percentile_cont(0.95) WITHIN GROUP (ORDER BY r.inference_duration_ms) AS \"p95 inférence\" FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status = 200 GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
