            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.registered_name || ' v' || m.version AS \"Modèle\", m.qualification AS \"Qualification\", m.mlflow_run_id AS \"Run MLflow\", count(*) AS \"Prédictions\", min(p.created_at) AS \"Première\", max(p.created_at) AS \"Dernière\" FROM tracing.predictions p JOIN tracing.api_requests r USING (request_id) JOIN tracing.model_versions m USING (model_id) WHERE $__timeFilter(p.created_at) AND r.campaign_id IN ($campaign) GROUP BY 1, 2, 3 ORDER BY 6 DESC"
        }
      ],
      "fieldConfig": {
