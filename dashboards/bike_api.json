    {
      "id": 20,
      "title": "Exécutions du pipeline",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "Écrit par les hooks du flow Prefect (succès comme échec).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Exécutions\", count(*) FILTER (WHERE status = 'COMPLETED') AS \"Réussies\", count(*) FILTER (WHERE status <> 'COMPLETED') AS \"En échec\", count(*) FILTER (WHERE promoted) AS \"Promotions\" FROM tracing.pipeline_runs WHERE $__timeFilter(started_at) AND trigger <> 'test'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "title": "MAE par exécution (modèle vs baseline)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT started_at AS time, test_mae AS \"MAE modèle\", baseline_mae AS \"MAE baseline\" FROM tracing.pipeline_runs WHERE $__timeFilter(started_at) AND trigger <> 'test' AND status = 'COMPLETED' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 22,
      "title": "Durée des exécutions par état",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT started_at AS time, status AS metric, duration_s AS value FROM tracing.pipeline_runs WHERE $__timeFilter(started_at) AND trigger <> 'test' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 23,
      "title": "Dernières exécutions",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT started_at AS \"Début\", run_name AS \"Run\", trigger AS \"Déclencheur\", status AS \"État\", coalesce(failed_step, '-') AS \"Étape en échec\", round(duration_s::numeric, 1) AS \"Durée (s)\", snapshot_rows AS \"Lignes\", batches AS \"Lots\", round(test_mae::numeric, 2) AS \"MAE test\", round(baseline_mae::numeric, 2) AS \"MAE baseline\", coalesce(model_version, '-') AS \"Version\", coalesce(qualification, '-') AS \"Qualification\", left(coalesce(error, ''), 160) AS \"Erreur\", mlflow_run_id AS \"Run MLflow\" FROM tracing.pipeline_runs WHERE $__timeFilter(started_at) AND trigger <> 'test' ORDER BY started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 100,
      "type": "row",
      "title": "Usage",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Requêtes (tentatives / succès)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Tentatives\", count(*) FILTER (WHERE r.http_status < 400) AS \"Succès\" FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Requêtes par seconde",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 9,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint AS metric, count(*) / ($__interval_ms / 1000.0) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Heures prédites par seconde",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "Débit de jeux : un lot de 20 heures compte 20.",
      "gridPos": {
        "x": 15,
        "y": 16,
        "w": 9,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint AS metric, sum(r.n_items) / ($__interval_ms / 1000.0) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status = 200 AND r.endpoint LIKE '/predict%' GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
