          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), 'pid ' || r.worker_pid || ' / ' || left(r.instance_id::text, 8) AS metric, count(*) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2 ORDER BY 1"
        }
