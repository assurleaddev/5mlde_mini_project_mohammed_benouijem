    },
    {
      "id": 4,
      "title": "Taux d'erreur 4xx / 5xx par endpoint",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint || ' ' || CASE WHEN r.http_status >= 500 THEN '5xx' ELSE '4xx' END AS metric, 100.0 * count(*) FILTER (WHERE r.http_status >= 400) / count(*) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Codes d'erreur",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bike-api-postgres"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bike-api-postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.endpoint AS \"Endpoint\", r.http_status AS \"HTTP\", coalesce(r.error_code, '-') AS \"Code\", count(*) AS \"Nombre\", round(100.0 * count(*) / sum(count(*)) OVER (PARTITION BY r.endpoint), 2) AS \"% endpoint\" FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2, 3 ORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "pas de données"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 102,
